<% content_for :title, "Great Hall - Voting" %>
<% content_for :body_class, "voting-summary-page" %>

<% content_for :head do %>
<style>
/* Reset and base styles */
body.voting-summary-page {
  margin: 0;
  padding: 0;
  font-family: "IM Fell English", serif;
  overflow: hidden;
}

body.voting-summary-page .app-main {
  padding: 0 !important;
  margin: 0 !important;
}

/* Great Hall Container */
.great-hall {
  position: fixed;
  top: 0;
  left: calc(13rem + 2rem + 0.5rem); /* navbar width + left margin + right margin */
  right: 0;
  bottom: 0;
  overflow: hidden;
}

@media (min-width: 640px) {
  .great-hall {
    left: calc(13rem + 2.5rem + 1rem); /* navbar width + left margin + right margin on larger screens */
  }
}

/* Background Layers */
.background-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.background-layer.castle {
  background-image: url('<%= asset_path('great_hall.webp') %>');
  z-index: 1;
}

.background-layer.user-meeple {
  z-index: 2;
  background: transparent;
  pointer-events: none;
}

.background-layer.throne {
  background-image: url('<%= asset_path('great_hall_throne.webp') %>');
  z-index: 3;
  pointer-events: none;
}

/* User Meeple on Throne */
.user-meeple-container {
  position: absolute;
  left: 17%;
  top: 43%;
  width: min(475px, 25vw);
  height: min(475px, 25vw);
  transform: translate(-50%, -50%);
  z-index: 2;
  pointer-events: none;
}

.user-meeple-container img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Presenting Meeple with Animations */
.presenting-meeple {
  position: absolute;
  width: min(425px, 22vw);
  height: min(425px, 22vw);
  z-index: 4;
  pointer-events: none;
  transition: transform 0.1s ease-out;
  /* Start off-screen by default */
  left: 110%;
  top: 70%;
  transform: translate(-50%, -50%);
}

.presenting-meeple img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Animation states */
.presenting-meeple[data-state="entering"] {
  animation: 
    walkInMove 2s ease-out forwards,
    waddleIn 2s linear forwards;
}

.presenting-meeple[data-state="exiting"] {
  animation: 
    walkOutMove 1s ease-in forwards,
    waddleOut 1s linear forwards;
}

.presenting-meeple[data-state="speaking"] {
  left: 60%;
  top: 70%;
  transform: translate(-50%, -50%);
}

.presenting-meeple[data-state="idle"] {
  left: 110%;
  top: 70%;
  transform: translate(-50%, -50%);
}

@keyframes walkInMove {
  0% {
    left: 110%;
    top: 70%;
  }
  100% {
    left: 60%;
    top: 70%;
  }
}

@keyframes waddleIn {
  0% { transform: translate(-50%, -50%) rotate(0.3rad); }
  4.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  5% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  9.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  10% { transform: translate(-50%, -50%) rotate(0.3rad); }
  14.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  15% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  19.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  20% { transform: translate(-50%, -50%) rotate(0.3rad); }
  24.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  25% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  29.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  30% { transform: translate(-50%, -50%) rotate(0.3rad); }
  34.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  35% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  39.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  40% { transform: translate(-50%, -50%) rotate(0.3rad); }
  44.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  45% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  49.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  50% { transform: translate(-50%, -50%) rotate(0.3rad); }
  54.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  55% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  59.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  60% { transform: translate(-50%, -50%) rotate(0.3rad); }
  64.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  65% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  69.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  70% { transform: translate(-50%, -50%) rotate(0.3rad); }
  74.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  75% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  79.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  80% { transform: translate(-50%, -50%) rotate(0.3rad); }
  84.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  85% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  89.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  90% { transform: translate(-50%, -50%) rotate(0.3rad); }
  94.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  95% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  99.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  100% { transform: translate(-50%, -50%) rotate(0); }
}

@keyframes walkOutMove {
  0% {
    left: 60%;
    top: 70%;
  }
  100% {
    left: 110%;
    top: 70%;
  }
}

@keyframes waddleOut {
  0% { transform: translate(-50%, -50%) rotate(0.3rad); }
