  34.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  35% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  39.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  40% { transform: translate(-50%, -50%) rotate(0.3rad); }
  44.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  45% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  49.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  50% { transform: translate(-50%, -50%) rotate(0.3rad); }
  54.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  55% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  59.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  60% { transform: translate(-50%, -50%) rotate(0.3rad); }
  64.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  65% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  69.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  70% { transform: translate(-50%, -50%) rotate(0.3rad); }
  74.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  75% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  79.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  80% { transform: translate(-50%, -50%) rotate(0.3rad); }
  84.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
  85% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  89.99% { transform: translate(-50%, -50%) rotate(-0.3rad); }
  90% { transform: translate(-50%, -50%) rotate(0.3rad); }
  94.99% { transform: translate(-50%, -50%) rotate(0.3rad); }
